# ============================================================
# SMRITI AI — ENVIRONMENT CONFIGURATION
# ============================================================


# ============================================================
# 1. APPLICATION
# ============================================================

APP_NAME=SMRITI AI
APP_ENV=development
DEBUG=true

API_HOST=127.0.0.1
API_PORT=8000

FRONTEND_URL=http://localhost:5173


# ============================================================
# 2. SECURITY
# ============================================================

SECRET_KEY=change-this-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=60


# ============================================================
# 3. DATABASE — POSTGRESQL
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=smriti_ai
DB_USER=smriti_user
DB_PASSWORD=smriti_dev_password

DATABASE_URL=postgresql+psycopg://smriti_user:smriti_dev_password@localhost:5432/smriti_ai



# ============================================================
# 4. VECTOR SEARCH — PGVECTOR
# ============================================================

VECTOR_DIMENSION=1536

VECTOR_DISTANCE_METRIC=cosine


# ============================================================
# 5. GOOGLE CONNECTORS
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/callback

GOOGLE_DRIVE_ENABLED=true
GMAIL_ENABLED=true
GOOGLE_CLASSROOM_ENABLED=true


# ============================================================
# 6. LOCAL STORAGE CONNECTOR
# ============================================================

LOCAL_STORAGE_ENABLED=true

# Development-only example
LOCAL_STORAGE_ROOT=


# ============================================================
# 7. LLM
# ============================================================

LLM_PROVIDER=

LLM_API_KEY=

LLM_MODEL=

LLM_TEMPERATURE=0.2

LLM_MAX_TOKENS=2000


# ============================================================
# 8. EMBEDDINGS
# ============================================================

EMBEDDING_PROVIDER=

EMBEDDING_API_KEY=

EMBEDDING_MODEL=

EMBEDDING_DIMENSION=1536


# ============================================================
# 9. DOCUMENT EXTRACTION
# ============================================================

MAX_FILE_SIZE_MB=100

EXTRACTION_TIMEOUT_SECONDS=120

SUPPORTED_FILE_TYPES=pdf,docx,doc,pptx,ppt,xlsx,xls,csv,txt,md,json,xml,yaml,yml


# ============================================================
# 10. CONTENT PROCESSING
# ============================================================

CHUNK_SIZE=800

CHUNK_OVERLAP=120

MAX_CONTENT_LENGTH=100000


# ============================================================
# 11. PRIVACY / DATA PROCESSING
# ============================================================

STORE_ORIGINAL_FILES=false

STORE_RAW_FILE_CONTENT=false

STORE_EXTRACTED_TEXT=true

ENABLE_PRIVACY_FILTER=true

ENABLE_LLM_ENRICHMENT=true


# ============================================================
# 12. RETRIEVAL
# ============================================================

ENABLE_LEXICAL_SEARCH=true

ENABLE_SEMANTIC_SEARCH=true

ENABLE_HYBRID_SEARCH=true

LEXICAL_WEIGHT=0.4

SEMANTIC_WEIGHT=0.6

TOP_K=10


# ============================================================
# 13. RAG
# ============================================================

ENABLE_RAG=true

RAG_TOP_K=5

RAG_MAX_CONTEXT_TOKENS=6000


# ============================================================
# 14. BACKGROUND PROCESSING
# ============================================================

WORKER_ENABLED=true

MAX_WORKER_CONCURRENCY=2

JOB_MAX_RETRIES=3


# ============================================================
# 15. SYNC
# ============================================================

SYNC_BATCH_SIZE=50

SYNC_MAX_RETRIES=3

SYNC_TIMEOUT_SECONDS=300

ENABLE_SCHEDULED_SYNC=true

ENABLE_MANUAL_SYNC=true


# ============================================================
# 16. LOGGING
# ============================================================

LOG_LEVEL=INFO

LOG_FORMAT=default


# ============================================================
# 17. CORS
# ============================================================

CORS_ORIGINS=http://localhost:5173